
#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1'000'000'007;

long long modPow(long long a, long long b, long long mod) {
    long long ans = 1;
    a %= mod;

    while (b > 0) {
        if (b & 1) {
            ans = ans * a % mod;
        }

        a = a * a % mod;
        b /= 2;
    }

    return ans;
}

int main() {
    long long a = 3;
    long long p = MOD;

    // Fermat's Little Theorem:
    // inverse of a modulo p = a^(p-2) modulo p
    cout << modPow(a, p - 2, p) << '\n';
}
